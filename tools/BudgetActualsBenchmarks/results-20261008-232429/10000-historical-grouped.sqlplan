<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.564" Build="16.0.1200.5"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT [s].[CategoryId], [s].[Year], [s].[Month], COALESCE(SUM([s].[Amount]), 0.0)&#xd;&#xa;FROM (&#xd;&#xa;    SELECT [t].[Amount], [t].[CategoryId], DATEPART(year, [t].[TransactionDate]) AS [Year], DATEPART(month, [t].[TransactionDate]) AS [Month]&#xd;&#xa;    FROM [Transactions] AS [t]&#xd;&#xa;    INNER JOIN [Accounts] AS [a] ON [t].[AccountId] = [a].[Id]&#xd;&#xa;    LEFT JOIN [Categories] AS [c] ON [t].[CategoryId] = [c].[Id]&#xd;&#xa;    WHERE [t].[HouseholdId] = @householdId AND [t].[TransactionDate] &gt;= @fromDate AND [t].[TransactionDate] &lt;= @toDate AND [t].[IsVoided] = CAST(0 AS bit) AND [t].[IsExcludedFromBudget] = CAST(0 AS bit) AND ([t].[IncludeInHouseholdBudget] = CAST(1 AS bit) OR ([t].[IncludeInHouseholdBudget] IS NULL AND [a].[Scope] = &apos;Household&apos;)) AND [c].[Type] = &apos;Expense&apos; AND [a].[Currency] = @currency&#xd;&#xa;) AS [s]&#xd;&#xa;GROUP BY [s].[CategoryId], [s].[Year], [s].[Month]" StatementId="1" StatementCompId="2" StatementType="SELECT" StatementSqlHandle="0x090093D413647D90A224C262C27054B2AECB0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="2" ParentObjectId="0" StatementParameterizationType="1" RetrievedFromCache="true" StatementSubTreeCost="2.02828" StatementEstRows="85.9167" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x6430E57D8EE10735" QueryPlanHash="0x9437845395E36A46" StatementOptmEarlyAbortReason="TimeOut" CardinalityEstimationModelVersion="160"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="0" MemoryGrant="2176" NonParallelPlanReason="NoParallelPlansInDesktopOrExpressEdition" CachedPlanSize="96" Comp